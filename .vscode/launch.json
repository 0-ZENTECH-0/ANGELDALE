{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open Angel Dale in Chrome (localhost:8080)",
            "url": "http://localhost:8080/index.html",
            "webRoot": "${workspaceFolder}",
            // Starts the local server first, so localhost never refuses to connect.
            "preLaunchTask": "Serve Site (port 8080)"
        },
        {
            "type": "edge",
            "request": "launch",
            "name": "Open Angel Dale in Edge (localhost:8080)",
            "url": "http://localhost:8080/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Serve Site (port 8080)"
        }
    ]
}
